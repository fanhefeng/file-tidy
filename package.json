{
  "name": "@fanhefeng/file-tidy",
  "version": "0.5.3",
  "description": "Organize files into prefixed category folders with byte-level dedup, near-duplicate and similar-image detection, and one-step undo",
  "keywords": [
    "cli",
    "files",
    "organize",
    "archive",
    "deduplication",
    "raycast"
  ],
  "homepage": "https://github.com/fanhefeng/file-tidy#readme",
  "bugs": {
    "url": "https://github.com/fanhefeng/file-tidy/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fanhefeng/file-tidy.git"
  },
  "license": "MIT",
  "author": "fhf1121",
  "type": "module",
  "bin": {
    "tidy": "bin/tidy.js"
  },
  "files": [
    "bin",
    "src",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.23.5 || ^24.22.3 || ^26.13.1"
  },
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "test": "node --test test/*.test.js test-adapters/*.test.js && node scripts/sync.js --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync": "node scripts/sync.js",
    "sync:fork": "node scripts/sync.js --fork",
    "desktop:dev": "npm --prefix desktop run dev",
    "desktop:build": "npm --prefix desktop run build",
    "desktop:package": "npm --prefix desktop run package",
    "desktop:test": "npm --prefix desktop test",
    "desktop:smoke": "npm --prefix desktop run test:smoke"
  },
  "dependencies": {
    "exifr": "^7.1.3",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "music-metadata": "^12.5.0"
  },
  "devDependencies": {
    "prettier": "^3.9.5"
  },
  "exports": {
    ".": {
      "types": "./src/core/index.d.ts",
      "import": "./src/core/index.js"
    },
    "./core": {
      "types": "./src/core/index.d.ts",
      "import": "./src/core/index.js"
    }
  }
}
