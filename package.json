{
  "name": "file-tidy",
  "version": "0.5.2",
  "description": "Organize files into prefixed category folders with byte-level dedup, near-duplicate and similar-image detection, and one-step undo",
  "keywords": [
    "cli",
    "files",
    "organize",
    "archive",
    "deduplication",
    "raycast"
  ],
  "homepage": "https://github.com/fanhefeng/file-tidy#readme",
  "bugs": {
    "url": "https://github.com/fanhefeng/file-tidy/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fanhefeng/file-tidy.git"
  },
  "license": "MIT",
  "author": "fhf1121",
  "type": "module",
  "bin": {
    "tidy": "bin/tidy.js"
  },
  "files": [
    "bin",
    "src",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.12.0"
  },
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "test": "node --test test/core.test.js test/smart.test.js && node scripts/sync.js --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync": "node scripts/sync.js",
    "sync:fork": "node scripts/sync.js --fork"
  },
  "dependencies": {
    "exifr": "^7.1.3",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "prettier": "^3.9.5"
  }
}
