{
  "name": "file-tidy-desktop",
  "version": "0.5.3",
  "private": true,
  "description": "A quiet workspace for organizing your files",
  "author": "fhf1121",
  "license": "MIT",
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "package": "npm run build && electron-builder",
    "package:dir": "npm run build && electron-builder --dir",
    "icon:macos": "node scripts/build-macos-icon.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "exifr": "^7.1.3",
    "jpeg-js": "^0.4.4",
    "music-metadata": "^12.5.0",
    "pngjs": "^7.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
